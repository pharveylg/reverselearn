# ReverseLearn MVP is local-first: no key is required.
# Deterministic lessons work with AI_PROVIDER=none (the default).
AI_PROVIDER=none
# Only set ONE of these server-side if you later enable the AI adapter.
# Never expose these to the browser (no NEXT_PUBLIC_ prefix).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MODEL=
